index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..65b7894e020bb402e129a771f586fc51fe420219 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -174,6 +174,7 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
       build(q)
       return write(toBuffer(q))
         && !q.describeFirst
+        && (!q.skipDescribe || !!connection.reserved) // Foundmill patch: see sendsWithoutDescribe
         && !q.cursorFn
         && sent.length < max_pipeline
         && (!q.options.onexecute || q.options.onexecute(connection))
@@ -237,7 +238,8 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     q.onlyDescribe && (delete statements[q.signature])
     q.parameters = q.parameters || parameters
     q.prepared = q.prepare && q.signature in statements
-    q.describeFirst = q.onlyDescribe || (parameters.length && !q.prepared)
+    q.skipDescribe = !q.onlyDescribe && parameters.length > 0 && !q.prepared && sendsWithoutDescribe(q, types) // Foundmill patch
+    q.describeFirst = q.onlyDescribe || (parameters.length && !q.prepared && !q.skipDescribe)
     q.statement = q.prepared
       ? statements[q.signature]
       : { string, types, name: q.prepare ? statementId + statementCount++ : '' }
@@ -245,6 +247,21 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     typeof options.debug === 'function' && options.debug(id, string, parameters, types)
   }
 
+  // Foundmill patch (patches/postgres@3.4.9.patch; docs/DECISIONS.md 2026-10-12 "Round trips per procedure"). With
+  // prepared statements off (Supabase's transaction pooler), a statement with parameters was always described first:
+  // its parameter types asked of the server, and only then its values sent. That costs a second round trip and stops
+  // pipelining. Describing only matters for a value whose type is unknown here and whose text depends on the type the
+  // server infers. A string or a number does not, under the serializers Drizzle installs (json and dates pass through
+  // as text): it is sent as its text and Postgres parses it as it would a literal. So a statement whose untyped values
+  // are all strings, numbers or null goes as Parse, Describe, Bind and Execute in one go, like a statement without
+  // parameters. Arrays and objects of unknown type are still described first.
+  // Flow control is unchanged outside a transaction: such a statement still holds its connection until it is answered
+  // (no pipelining on a pooled connection, as before). Inside sql.begin or sql.reserve the connection is the session's
+  // own, and the statements of a transaction are pipelined.
+  function sendsWithoutDescribe(q, types) {
+    return !q.prepare && q.parameters.every((x, i) => types[i] || x === null || typeof x === 'string' || typeof x === 'number')
+  }
+
   function write(x, fn) {
     chunk = chunk ? Buffer.concat([chunk, x]) : Buffer.from(x)
     if (fn || chunk.length >= 1024)
