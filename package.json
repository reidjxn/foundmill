{
  "name": "foundmill",
  "private": true,
  "version": "0.1.0",
  "description": "Foundmill: the agent platform where any founder builds a real business end to end with a squad of AI agents.",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.23.3"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:rls": "pnpm --filter @foundmill/db test:rls",
    "test:e2e": "pnpm --filter @foundmill/e2e test",
    "db:migrate": "pnpm --filter @foundmill/db migrate",
    "db:seed": "pnpm --filter @foundmill/db seed",
    "evals": "pnpm --filter @foundmill/evals evals",
    "storybook": "pnpm --filter @foundmill/dugout storybook",
    "storybook:build": "pnpm --filter @foundmill/dugout storybook:build",
    "format": "prettier --write .",
    "banned-terms": "node scripts/banned-terms.mjs",
    "us-english": "node scripts/us-english.mjs",
    "plain-language": "node scripts/plain-language.mjs",
    "focus-visible": "node scripts/focus-visible.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
