# Core
APP_ENV=development
INTEGRATIONS_MODE=mock            # mock | live
MODEL_MODE=mock                   # mock | live  (model layer; evals always use live)
MODEL_FAST_MODE=0                 # 1 = Opus fast mode on the draft routes that ask for it (beta, 2x price)
MOCK_MODEL_LATENCY_MS=0           # mock models: wait before the first token (dev only; 0 keeps tests instant)
MOCK_MODEL_STREAM_MS=0            # mock models: writing time per streamed element (dev only)
APP_URL=http://localhost:3000
DATA_REGION=eu                    # eu | us
LOG_LEVEL=info

# Service URLs (web -> services). Public ones are exposed to the browser bundle.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STREAM_URL=ws://localhost:4003
NEXT_PUBLIC_COLLAB_URL=ws://localhost:4004
API_PORT=4000
GATEWAY_PORT=4001
COMPOSER_PORT=4002
STREAM_PORT=4003
COLLAB_PORT=4004
INGEST_PORT=4005
SOCIAL_PORT=4006
GATEWAY_URL=http://localhost:4001
COMPOSER_URL=http://localhost:4002
# How long the api and the orchestrator wait for a composer note (ms); empty = 180000, above the composer's 150 s deadline.
COMPOSER_TIMEOUT_MS=
INGEST_URL=http://localhost:4005

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-side only, never in web bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=                     # postgres://... (session pooler for workers, transaction pooler for api)

# Platform model key (platform credits). Founders' own keys live encrypted in DB.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Infra
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=foundmill
E2B_API_KEY=
BROWSERBASE_API_KEY=
KMS_KEY_ID=
DEV_MASTER_KEY=                   # local only, 32 bytes base64 (generate: openssl rand -base64 32)
SESSION_TOKEN_SECRET=             # 32+ bytes, signs gateway/stream session tokens (generate: openssl rand -base64 32)

# Platform billing
STRIPE_SECRET_KEY=                # gateway: the platform Stripe account (credit top-ups through Checkout; Connect)
STRIPE_WEBHOOK_SECRET=            # ingest: businesses' own Stripe events (/webhooks/stripe/<business id>)
STRIPE_BILLING_WEBHOOK_SECRET=    # ingest: Foundmill's own billing endpoint (/billing/stripe); unset refuses every delivery
STRIPE_CONNECT_CLIENT_ID=

# Connectors (only needed in live mode; see docs/BUILD.md §13)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
TINK_CLIENT_ID=
TINK_CLIENT_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
COMPANIES_HOUSE_API_KEY=
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
OPENCORPORATES_API_TOKEN=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Seeds
SEED_OWNER_EMAILS=                # comma-separated emails that get owner membership of the demo businesses

# Access (api)
SIGNUP_ALLOWLIST=                 # who may use the app: emails and @domains, comma-separated ("you@example.com, @example.org"); empty admits every account that can sign in

# Development/test only (ignored unless APP_ENV is development or test)
DEV_AUTH_USER_ID=                 # bypass JWT verification with this user id (Playwright, local dev without Supabase Auth)
