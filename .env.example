# Every variable the code reads, one line each (scripts/env-example.test.mjs keeps this file equal to the schemas:
# packages/shared/src/env.ts, apps/orchestrator/src/env.ts, the NEXT_PUBLIC_* the web app reads and the seed CLI's).
# Which service needs which on Railway: docs/DEPLOY.md §3. Empty = unset (the default applies).

# --- Core (every service) ------------------------------------------------------------------------------------------
APP_ENV=development                # development | test | staging | production
INTEGRATIONS_MODE=mock             # mock | live
LIVE_CONNECTORS=                   # live while INTEGRATIONS_MODE is mock, comma-separated: connector keys (github, domains) and stripe_billing for real credit top-ups (api and gateway)
MODEL_MODE=mock                    # mock | live (model layer; evals always use live)
LIVE_MODE=0                        # 1 opens the LIVE surfaces (network, communities, Go live); closed until the social layer ships (FLAGS.liveMode)
MODEL_LIMIT_SCALE=1                 # development and test only: multiplies the per-person and per-business allowances on model-backed buttons (the Playwright stack sets 50); ignored on staging and production
MODEL_FAST_MODE=0                  # 1 = Opus fast mode on the draft routes that ask for it (beta, 2x price)
MOCK_MODEL_LATENCY_MS=0            # mock models: wait before the first token (dev only; 0 keeps tests instant)
MOCK_MODEL_STREAM_MS=0             # mock models: writing time per streamed element (dev only)
APP_URL=http://localhost:3000      # the web app's origin (links in notes and email, the OAuth redirect URI)
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=               # SIGTERM to exit, ms; empty = 45000 (keep below railway.toml drainingSeconds)

# --- Ports and service URLs ----------------------------------------------------------------------------------------
PORT=                              # Railway sets it; each service falls back to its own port below
API_PORT=4000
GATEWAY_PORT=4001
COMPOSER_PORT=4002
STREAM_PORT=4003
COLLAB_PORT=4004
INGEST_PORT=4005
ORCHESTRATOR_PORT=4007             # orchestrator GET /health (Railway: PORT)
GATEWAY_URL=http://localhost:4001  # api, orchestrator, composer -> gateway
COMPOSER_URL=http://localhost:4002 # api, orchestrator -> composer
COMPOSER_TIMEOUT_MS=               # api, orchestrator: wait for a composer note, ms; empty = 180000 (above its 150 s deadline)
API_DB_POOL_MAX=                   # api: its database pool size; empty = 10. Raise only with room under Postgres max_connections (docs/DEPLOY.md "Database connections")
INGEST_URL=http://localhost:4005   # api -> ingest (the Simulate panel); on Railway http://ingest.railway.internal:<ingest port>

# --- Web app (browser bundle; set on Vercel) ------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STREAM_URL=ws://localhost:4003
NEXT_PUBLIC_COLLAB_URL=ws://localhost:4004
NEXT_PUBLIC_INGEST_URL=http://localhost:4005
NEXT_PUBLIC_INTEGRATIONS_MODE=mock
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_GOOGLE=           # "on" shows Continue with Google on /login (set up Google in Supabase first: docs/DEPLOY.md §4)
NEXT_PUBLIC_STORE_LINKS=           # web: the native app's App Store and Google Play links, comma-separated; unset until launch = no prompt
APP_LINKS_IOS_APP_ID=                 # web: <Team ID>.com.foundmill.app; serves /.well-known/apple-app-site-association (404 while unset; set at launch with the store links)
APP_LINKS_ANDROID_PACKAGE=            # web: the Android package name; with APP_LINKS_ANDROID_SHA256 serves /.well-known/assetlinks.json (404 while unset)
APP_LINKS_ANDROID_SHA256=             # web: the signing certificate SHA-256 fingerprint(s), comma-separated

# --- Supabase and the database -------------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server-side only, never in the web bundle
SUPABASE_JWT_SECRET=               # api, stream, collab: legacy HS256 token secret (optional; JWKS is used otherwise)
DATABASE_URL=                      # postgres://... (transaction pooler :6543 turns prepared statements off) or pglite:<dir>
MIGRATION_LOCK_TIMEOUT_MS=         # api: longest wait at boot for the migration lock, ms; empty = 60000

# --- Infra ---------------------------------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=foundmill
KMS_KEY_ID=
DEV_MASTER_KEY=                    # api, gateway, ingest, orchestrator: 32 bytes base64, identical on each (openssl rand -base64 32)
SESSION_TOKEN_SECRET=              # api, gateway, orchestrator, ingest, collab: 32+ bytes, identical on each
API_SERVICE_TOKEN_SECRET=          # api and gateway only: 32+ characters, identical on both; the api signs its gateway calls with it (DEPLOY §3)
API_SERVICE_TOKEN_LEGACY=          # gateway: 1 while switching to API_SERVICE_TOKEN_SECRET; remove when the api has it (DEPLOY §3)
COMPOSER_SERVICE_TOKEN_SECRET=     # composer and gateway only: 32+ characters, identical on both; a founder's own key for the composer's notes (WP-13 T11)

# --- Observability (every Node service) ----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=       # OTLP/HTTP base URL for traces (and Temporal metrics), e.g. Grafana Cloud's /otlp
OTEL_EXPORTER_OTLP_HEADERS=        # key=value,... (percent-encoded), e.g. Authorization=Basic%20<base64>
SENTRY_DSN=                        # error-level log lines and uncaught exceptions are reported here

# --- Orchestrator --------------------------------------------------------------------------------------------------
SANDBOX_MODE=                      # mock | docker | e2b; empty follows INTEGRATIONS_MODE
ORCHESTRATOR_MAX_ACTIVITIES=32
ORCHESTRATOR_MAX_SESSIONS=16
ORCHESTRATOR_MAX_WORKFLOWS=100
APPROVAL_WAIT_MINUTES=30
SESSION_PAUSE_HOLD_MINUTES=10
MOCK_SESSION_SPEED=4
MOCK_SESSION_SCENARIOS=done        # done | all: which recorded sessions mock mode replays on its own (all adds the failed and blocked ones)
ORCHESTRATOR_SCHEDULES=on          # on | off: register the periodic jobs' Temporal Schedules at boot
MOCK_RESULTS_CLEANUP=report        # off | report | apply: the nightly removal of generated results from real projects (WP-02 T4; apply only with the founder's yes)
WAITLIST_ADMIT_PER_DAY=            # people the waitlist lets in per UTC day, oldest first (WP-03 T2); empty means 0 (docs/DEPLOY.md §4); the sweep reads SIGNUP_OPEN and SIGNUP_DAILY_CEILING too, so set them as on the api
WAITLIST_EMAILS=                   # api: "1" lets the waitlist page promise the admission email, and only while platform mail is live (WP-03 T2; docs/DEPLOY.md §4)
ORCHESTRATOR_WORKSPACE_DIR=/tmp/foundmill-workspaces
TEMPORAL_RETRY_SECONDS=10

# --- Platform model and tool keys ----------------------------------------------------------------------------------
ANTHROPIC_API_KEY=                 # platform credits; founders' own keys live encrypted in the database
ZAI_API_KEY=                       # GLM-5.3 Flash for accounts not on a paid plan (WP-13)
FREE_PLAN_MONTHLY_CAP_CENTS=60000  # the month's ceiling on all free-plan spend, Haiku 5.5 and GLM ($600)
FREE_SESSION_MODEL=haiku           # free agent sessions: haiku until a measured GLM session costs about $0.019, then glm
VOYAGE_API_KEY=
OPENAI_API_KEY=                    # gateway only: the AI-generated faces of anthropomorphic agents (connector openai_images)
ELEVENLABS_API_KEY=                # gateway only: speech for Team call (connector elevenlabs); live with LIVE_CONNECTORS=elevenlabs on the gateway and the api, else the browser's own speech stands in
ELEVENLABS_SPEECH_ACCENT_IDS=             # gateway only, optional: JSON {"talia":"<ElevenLabs id>"} replacing the default id of an accent, key by key
ONESIGNAL_APP_ID=                  # gateway only: push to the mobile app's phones (connector onesignal, docs/mobile); the app id of Foundmill's own OneSignal app
ONESIGNAL_API_KEY=                 # gateway only: that OneSignal app's REST API key
TURNSTILE_SECRET_KEY=              # gateway only: Cloudflare Turnstile secret for the idea box (docs/IDEA_BOX.md); unset = mock on dev stacks
IDEA_COOKIE_DOMAIN=                # api only: foundmill.com in production so the web reads the idea box cookie; unset = host-only
IDEA_BOX_DAILY_CEILING_CENTS=2000  # api only: the idea box's daily model spend ceiling across all visitors (US cents)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=    # web: Cloudflare Turnstile site key for the idea box; unset = the mock token on dev stacks
NEXT_PUBLIC_SIGNIN_BOT_CHECK=      # web: "on" (with the site key) sends a Turnstile token with the sign-in email; only after Supabase's bot protection is on (docs/DEPLOY.md §4)
E2B_API_KEY=
E2B_TEMPLATE=                      # orchestrator: the E2B template acceptance sandboxes start from (infra/e2b); empty = E2B's base
BROWSERBASE_API_KEY=

# --- Platform billing ----------------------------------------------------------------------------------------------
STRIPE_SECRET_KEY=                 # gateway: the platform Stripe account (credit top-ups through Checkout; Connect)
STRIPE_WEBHOOK_SECRET=             # ingest: businesses' own Stripe events (/webhooks/stripe/<business id>)
STRIPE_BILLING_WEBHOOK_SECRET=     # ingest: Foundmill's own billing endpoint (/billing/stripe); unset refuses every delivery
STRIPE_CONNECT_CLIENT_ID=          # gateway: Connect onboarding (ca_...)

# --- Live connectors (platform keys; gateway only, plus ingest for webhooks, never the api: DEPLOY §5.6) ----------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
SENDGRID_INBOUND_TOKEN=
# --- A Foundmill sending address for every project (package 1.5; DEPLOY §5.7). Unset domain = off everywhere ----------
# Live only where SendGrid is live on the gateway (LIVE_CONNECTORS=sendgrid or INTEGRATIONS_MODE=live); else simulated.
PLATFORM_MAIL_DOMAIN=                  # api, gateway, ingest, orchestrator: e.g. mail.foundmill.com
SITES_DOMAIN=                          # api, orchestrator, sites: Foundmill Sites domain (WP-07); unset = off everywhere. Local: sites.localhost
SITES_API_URL=                         # sites: the api a site's sign-up form calls (WP-07 T6); unset = localhost:4000 in dev/test, closed elsewhere
SITES_TURNSTILE_SITE_KEY=               # sites: Turnstile site key for site sign-up forms (public); empty = mock token (dev/test only)
PLATFORM_MAIL_DAILY_CAP=50             # gateway (api shows it): messages per project per UTC day
PLATFORM_MAIL_DAILY_CEILING=2000       # gateway: every project together, per UTC day
PLATFORM_NOTIFY_DAILY_CEILING=1000     # gateway: Foundmill's own emails to its users per UTC day (its own ceiling, not the projects')
PLATFORM_SAFETY_DAILY_CEILING=5000     # gateway: ordinary founder notices per UTC day (1 or more; 0 or empty is refused at boot)
PLATFORM_SAFETY_RESERVED_DAILY_CEILING=20000 # gateway: circuit breaker over essential founder notices per UTC day (1 or more)
PLATFORM_MAIL_SIGNING_SECRET=          # gateway + ingest: 32+ random bytes; signs custom args and unsubscribe links
PLATFORM_MAIL_INBOUND_TOKEN=           # ingest: Inbound Parse URL ?token= for /mail/inbound
PLATFORM_MAIL_EVENT_PUBLIC_KEY=        # ingest: the platform Event Webhook's verification key (/mail/events)
INGEST_PUBLIC_URL=                     # gateway: https://ingest.foundmill.com (unsubscribe links); defaults to INGEST_URL
PLATFORM_NOTIFY_LOCAL_PART=hello       # gateway: Foundmill's own email to its users comes from <it>@PLATFORM_MAIL_DOMAIN (a reserved word)
NOTIFY_EMAIL=on                        # api: on | off: email a person when a note has waited a day for their answer (hourly pass)
PAGE_CATCH_UP_EMAIL=on                  # api: on | off: also email about the "page is ready" note the page catch-up writes for older projects (off: the note waits in the Inbox)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
TINK_CLIENT_ID=
TINK_CLIENT_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=                         # sandbox | production
COMPANIES_HOUSE_API_KEY=
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
OPENCORPORATES_API_TOKEN=
CLOUDFLARE_API_TOKEN=
GOOGLE_CLIENT_ID=                  # Gmail, Calendar, Drive (redirect URI: <APP_URL>/integrations/oauth/callback)
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=                  # redirect URI: <APP_URL>/integrations/oauth/callback
NOTION_CLIENT_SECRET=
DROPBOX_SIGN_API_KEY=

# --- Access and seeds (api) ----------------------------------------------------------------------------------------
SIGNUP_ALLOWLIST=                  # emails and @domains, comma-separated; empty admits every account that can sign in
SIGNUP_OPEN=                       # 1 = open sign-up with a daily ceiling; keep unset in production (docs/DEPLOY.md §4)
SIGNUP_DAILY_CEILING=              # with SIGNUP_OPEN: new accounts admitted per UTC day before the rest wait (default 200; 25 to open, an Estimate)
SIGNUP_PER_DOMAIN_PER_DAY=         # with SIGNUP_OPEN: new accounts per UTC day from one private email domain (default 5, an Estimate); large mail providers are not counted by domain
SIGNUP_EXISTING_BEFORE=            # with SIGNUP_OPEN: ISO time; accounts with a profile before it count as existing (default: the migration's)
ALLOW_MOCK_PAYMENTS=               # simulated top-ups on the Billing tab when Stripe is not live: empty = only in development/test, 1 = on, 0 = off
SEED_ON_BOOT=                      # 1 = build the demo businesses at boot when they are absent
SEED_OWNER_EMAILS=                 # comma-separated emails that get owner membership of the demo businesses
SEED_VOLUME_SCALE=                 # seed data volume (1 = two full years of history)
DEMO_ROLL_FORWARD=on               # on | off: move the demo businesses' sample rows forward with the calendar (boot + hourly)
# Seed CLI only (pnpm db:seed)
SEED_TARGET=                       # pglite = seed a local PGlite directory
SEED_PGLITE_DIR=
SEED_TODAY=                        # pin "today", e.g. 2026-10-07
SEED_DAYS=
SEED_OWNER_PROFILE=                # 0 = leave the demo owner without a founder profile

# --- Development and test only (ignored unless APP_ENV is development or test) --------------------------------------
DEV_AUTH_USER_ID=                  # bypass JWT verification with this user id (Playwright, local dev without Supabase Auth)
