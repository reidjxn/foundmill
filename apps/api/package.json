{
  "name": "@foundmill/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*.css": "./src/*.css",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "hono": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/trpc-server": "catalog:",
    "@trpc/server": "catalog:",
    "zod": "catalog:",
    "superjson": "catalog:",
    "jose": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "drizzle-orm": "catalog:",
    "@temporalio/client": "catalog:",
    "ioredis": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "@foundmill/db": "workspace:*",
    "@foundmill/events": "workspace:*",
    "@foundmill/shared": "workspace:*",
    "@foundmill/config": "workspace:*",
    "@foundmill/models": "workspace:*",
    "@foundmill/agents": "workspace:*",
    "@foundmill/policy": "workspace:*",
    "@foundmill/entity-linker": "workspace:*",
    "@foundmill/journey": "workspace:*",
    "@foundmill/connectors": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "tsx": "catalog:"
  }
}
