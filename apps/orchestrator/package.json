{
  "name": "@foundmill/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*.css": "./src/*.css",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@temporalio/client": "catalog:",
    "@temporalio/worker": "catalog:",
    "@temporalio/workflow": "catalog:",
    "@temporalio/activity": "catalog:",
    "@temporalio/common": "catalog:",
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@anthropic-ai/sdk": "catalog:",
    "ioredis": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "zod": "catalog:",
    "@foundmill/db": "workspace:*",
    "@foundmill/events": "workspace:*",
    "@foundmill/models": "workspace:*",
    "@foundmill/agents": "workspace:*",
    "@foundmill/policy": "workspace:*",
    "@foundmill/connectors": "workspace:*",
    "@foundmill/sandbox": "workspace:*",
    "@foundmill/shared": "workspace:*",
    "@foundmill/config": "workspace:*",
    "@foundmill/entity-linker": "workspace:*",
    "@foundmill/journey": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "tsx": "catalog:",
    "@temporalio/testing": "catalog:"
  }
}
