{
  "name": "@foundmill/widgets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./data": "./src/data.tsx",
    "./testing": "./src/testing.tsx",
    "./*.css": "./src/*.css",
    "./*": "./src/*.ts"
  },
  "sideEffects": [
    "./src/index.ts",
    "./src/widgets.ts",
    "./src/widgets/*.tsx",
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "react": "catalog:",
    "zod": "catalog:",
    "lucide-react": "catalog:",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@foundmill/dugout": "workspace:*",
    "@foundmill/shared": "workspace:*",
    "@foundmill/config": "workspace:*",
    "@foundmill/journey": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "vitest": "catalog:",
    "happy-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:"
  }
}
