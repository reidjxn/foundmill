{
  "name": "@foundmill/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*.css": "./src/*.css",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "report:retention": "tsx src/retention-report.ts",
    "report:metrics": "tsx src/metrics-report.ts",
    "report:cost": "tsx src/cost-report.ts",
    "notes:clear-day-one": "tsx src/clear-day-one-notes.ts",
    "test:rls": "vitest run --dir src/__tests__/rls",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@faker-js/faker": "catalog:",
    "@foundmill/agents": "workspace:*",
    "@foundmill/config": "workspace:*",
    "@foundmill/journey": "workspace:*",
    "@foundmill/models": "workspace:*",
    "@foundmill/shared": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "date-fns": "catalog:",
    "drizzle-orm": "catalog:",
    "nanoid": "catalog:",
    "postgres": "catalog:",
    "seedrandom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@types/seedrandom": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
