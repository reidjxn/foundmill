{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalEnv": ["APP_ENV", "INTEGRATIONS_MODE", "MODEL_MODE", "NODE_ENV", "CI"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**", "storybook-static/**"], "env": ["SIGNUP_OPEN", "LIVE_MODE", "PLATFORM_MAIL_DOMAIN"] },
    "dev": { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": [], "outputs": [] },
    "lint": { "dependsOn": [], "outputs": [] },
    "test": { "dependsOn": [], "outputs": ["coverage/**"], "passThroughEnv": ["FM_PGLITE_SNAPSHOT_DIR", "FM_PGLITE_SNAPSHOT"] },
    "test:rls": { "cache": false },
    "storybook:build": { "outputs": ["storybook-static/**"] }
  }
}
